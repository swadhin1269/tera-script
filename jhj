terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.4.0"
}

provider "aws" {
  region = var.aws_region
}

####################
# Variables
####################
variable "aws_region" {
  type    = string
  default = "us-east-1"
}

variable "lambda_runtime" {
  type    = string
  default = "python3.11"
}

variable "lambda_handler" {
  type    = string
  default = "lambda_function.lambda_handler"
}

####################
# S3 bucket
####################
resource "aws_s3_bucket" "uploads" {
  bucket        = "tf-s3-lambda-upload-example-${random_id.bucket_suffix.hex}"
  force_destroy = true
}

resource "random_id" "bucket_suffix" {
  byte_length = 4
}

####################
# SNS Topic + subscription (optional)
####################
resource "aws_sns_topic" "lambda_done" {
  name = "lambda-done-topic"
}

# Optional: email subscription for testing
resource "aws_sns_topic_subscription" "email" {
  topic_arn = aws_sns_topic.lambda_done.arn
  protocol  = "email"
  endpoint  = var.notification_email # set in tfvars for testing
  # remove or comment in prod
}

variable "notification_email" {
  type    = string
  default = "" # put your email in terraform.tfvars for dev
}

####################
# IAM role for Lambda
####################
data "aws_iam_policy_document" "lambda_assume" {
  statement {
    effect = "Allow"
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
    actions = ["sts:AssumeRole"]
  }
}

resource "aws_iam_role" "lambda_exec" {
  name               = "lambda-s3-sns-exec-role"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

# Inline policy: CloudWatch logs + SNS publish + optional S3 get
data "aws_iam_policy_document" "lambda_policy" {
  statement {
    sid    = "CloudWatchLogs"
    effect = "Allow"
    actions = [
      "logs:CreateLogGroup",
      "logs:CreateLogStream",
      "logs:PutLogEvents"
    ]
    resources = ["arn:aws:logs:${var.aws_region}:*:*"]
  }

  statement {
    sid    = "SNSPublish"
    effect = "Allow"
    actions = [
      "sns:Publish"
    ]
    resources = [
      aws_sns_topic.lambda_done.arn
    ]
  }

  # Optional: give read access to the bucket if your lambda will read object
  statement {
    sid    = "S3ReadObjectOptional"
    effect = "Allow"
    actions = [
      "s3:GetObject"
    ]
    resources = [
      "${aws_s3_bucket.uploads.arn}/*"
    ]
  }
}

resource "aws_iam_role_policy" "lambda_policy_attach" {
  name   = "lambda-s3-sns-policy"
  role   = aws_iam_role.lambda_exec.id
  policy = data.aws_iam_policy_document.lambda_policy.json
}

####################
# Package Lambda (assumes lambda_function.py in ./lambda_src)
####################
data "archive_file" "lambda_zip" {
  type        = "zip"
  source_dir  = "${path.module}/lambda_src"
  output_path = "${path.module}/lambda_build/lambda_package.zip"
}

resource "aws_lambda_function" "processor" {
  function_name = "s3-to-sns-processor"
  filename      = data.archive_file.lambda_zip.output_path
  source_code_hash = data.archive_file.lambda_zip.output_base64sha256
  handler       = var.lambda_handler
  runtime       = var.lambda_runtime
  role          = aws_iam_role.lambda_exec.arn
  timeout       = 30

  environment {
    variables = {
      SNS_TOPIC_ARN = aws_sns_topic.lambda_done.arn
    }
  }
}

####################
# Allow S3 to invoke Lambda
####################
resource "aws_lambda_permission" "allow_s3" {
  statement_id  = "AllowS3Invoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.processor.arn
  principal     = "s3.amazonaws.com"
  source_arn    = aws_s3_bucket.uploads.arn
}

####################
# S3 Bucket Notification
####################
resource "aws_s3_bucket_notification" "notify_lambda" {
  bucket = aws_s3_bucket.uploads.id

  lambda_function {
    lambda_function_arn = aws_lambda_function.processor.arn
    events              = ["s3:ObjectCreated:*"]
    # optional filter:
    # filter_prefix = "uploads/"
    # filter_suffix = ".csv"
  }

  # ensure lambda permission exists before creating notification
  depends_on = [
    aws_lambda_permission.allow_s3
  ]
}

####################
# Outputs
####################
output "s3_bucket_name" {
  value = aws_s3_bucket.uploads.bucket
}

output "sns_topic_arn" {
  value = aws_sns_topic.lambda_done.arn
}

output "lambda_function_name" {
  value = aws_lambda_function.processor.function_name
}
